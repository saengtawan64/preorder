rules_version = '2';

// Starter rules for the `deposits` collection.
//
// The app currently has no Firebase Auth, so submissions arrive unauthenticated.
// These rules therefore cannot answer "who is this?" — they can only constrain
// the shape and size of what gets written. Read the "Security model" section of
// the README before deploying this to anything holding real customer data.
//
// Deploy:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    match /deposits/{depositId} {

      function isWellFormed(data) {
        return data.keys().hasOnly([
                 'firstName', 'nickname', 'phoneNumber',
                 'depositItem', 'depositAmount', 'timestamp', 'createdAt'
               ])
               && data.keys().hasAll([
                 'firstName', 'phoneNumber', 'depositItem', 'depositAmount'
               ])
               && data.firstName is string   && data.firstName.size() <= 100
               && data.nickname is string    && data.nickname.size() <= 100
               && data.phoneNumber is string && data.phoneNumber.size() <= 20
               && data.depositItem is string && data.depositItem.size() <= 300
               && data.depositAmount is number
               && data.depositAmount > 0
               && data.depositAmount <= 10000000
               && data.timestamp is string   && data.timestamp.size() <= 60;
      }

      // The public lookup feature requires open reads. Note this exposes every
      // customer name and phone number to anyone with the Firebase project id.
      // Gate this behind Firebase Auth if that is not acceptable.
      allow read: if true;

      // Anyone can file a deposit, but only in the expected shape.
      allow create: if isWellFormed(request.resource.data);

      // Records are append-only: an existing deposit is never edited in place.
      allow update: if false;

      // Deleting requires a signed-in user. With no Auth wired up yet this
      // denies every delete, and the dashboard surfaces the failure rather
      // than pretending the row is gone. See README "Next steps".
      allow delete: if request.auth != null;
    }

    // Everything outside /deposits is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

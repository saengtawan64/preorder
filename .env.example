# Copy to .env and fill in. Everything here is inlined into the published
# bundle by Vite, so treat all of it as PUBLIC. This is fine for these values —
# the Firebase config only names the project, and the staff email is not a
# secret. The actual gate is the account's password, which is set in Firebase
# Console and never appears in this repo.

# --- Firebase ----------------------------------------------------------------
# From Firebase console > Project settings > Your apps > SDK setup, Config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Staff login ---------------------------------------------------------
# Email of the single shared Firebase Auth account (Authentication > Users).
# The login screen never shows this — it only asks for the password — so this
# just needs to match whatever email you created the account under.
VITE_STAFF_LOGIN_EMAIL=staff@deposit-tracker.local

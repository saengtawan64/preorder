# Copy to .env and fill in. Everything here is inlined into the published
# bundle by Vite, so treat all of it as PUBLIC. Nothing secret belongs in this
# file — access control lives in firestore.rules, not here.

# --- Google Sheets -----------------------------------------------------------
# "File > Share > Publish to web" on the deposits sheet, CSV output.
VITE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/XXXXXXXX/pub?gid=0&single=true&output=csv

# Apps Script Web App ("Deploy > New deployment > Web app") that appends a row.
VITE_SHEET_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# --- Firebase ----------------------------------------------------------------
# From Firebase console > Project settings > Your apps > SDK setup, Config.
# Optional: users can also paste this into the in-app "ตั้งค่า Firebase" modal.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Admin dashboard ---------------------------------------------------------
# PIN that reveals the dashboard UI. Ships in the bundle and is therefore
# readable by anyone who views source — it hides the screen, it does not
# protect the data. Defaults to 1234 when unset.
VITE_ADMIN_PIN=
